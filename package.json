{
  "name": "@masculinecache/simplefin-axi",
  "version": "0.1.3",
  "description": "Agent-ergonomic CLI for SimpleFIN financial data on Cloudflare D1",
  "type": "module",
  "bin": {
    "simplefin-axi": "dist/bin.js"
  },
  "files": [
    "dist",
    "SKILL.md"
  ],
  "scripts": {
    "build": "tsup bin.ts --format esm --sourcemap",
    "prepublishOnly": "npm run build",
    "postinstall": "node -e \"const fs=require('fs');const p=require('path');const d=p.join(require('os').homedir(),'.agents/skills/simplefin-axi');fs.mkdirSync(d,{recursive:true});fs.copyFileSync(p.join(__dirname,'SKILL.md'),p.join(d,'SKILL.md'));console.log('Skill installed to',d)\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^8.4.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masculinecache/simplefin-axi.git"
  },
  "homepage": "https://github.com/masculinecache/simplefin-axi"
}
